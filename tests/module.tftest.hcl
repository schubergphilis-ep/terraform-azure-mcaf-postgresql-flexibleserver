# Unit tests for the root module (plan only, mocked providers).

mock_provider "azurerm" {
  mock_data "azurerm_client_config" {
    defaults = {
      tenant_id = "00000000-0000-0000-0000-000000000000"
    }
  }
}

mock_provider "azuread" {}
mock_provider "random" {}

mock_provider "postgresql" {
  alias = "database"
}

variables {
  name                = "psql-test"
  resource_group_name = "rg-test"
  location            = "westeurope"
  sku                 = "GP_Standard_D2ds_v5"

  customer_managed_key = {
    key_vault_key_id                  = "https://kv-test.vault.azure.net/keys/cmk"
    primary_user_assigned_identity_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-test/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-test"
  }
}

run "default_is_entra_id_only" {
  command = plan

  assert {
    condition     = azurerm_postgresql_flexible_server.this.authentication[0].password_auth_enabled == false
    error_message = "Password authentication must be off by default."
  }

  assert {
    condition     = length(random_password.password) == 0
    error_message = "No administrator password may be generated by default."
  }
}

run "password_authentication_is_opt_in" {
  command = plan

  variables {
    password_auth_enabled = true
  }

  assert {
    condition     = length(random_password.password) == 1 && azurerm_postgresql_flexible_server.this.administrator_login == "sbp_administrator"
    error_message = "Opting in to password authentication must create the administrator login and password."
  }
}

run "access_is_scoped_per_database" {
  command = plan

  variables {
    provisioning_identity_name = "terraform-deployer"
    databases = {
      app = {
        reader_managed_identity_object_ids = [{ object_id = "11111111-1111-1111-1111-111111111111", principal_name = "app-reader" }]
      }
      app2 = {
        writer_managed_identity_object_ids = [{ object_id = "22222222-2222-2222-2222-222222222222", principal_name = "app2-writer" }]
        writer_groups                      = [{ group_name = "app2-writers-group", object_id = "33333333-3333-3333-3333-333333333333" }]
      }
    }
  }

  assert {
    condition     = module.database["app"].access.groups == { readers = "app_readers" }
    error_message = "Database app must only get an app_readers access group."
  }

  assert {
    condition     = module.database["app2"].access.groups == { writers = "app2_writers" }
    error_message = "Database app2 must only get an app2_writers access group."
  }

  assert {
    condition     = join(",", sort(module.database["app2"].access.writers)) == "app2-writer_service_writer,app2-writers-group_group_writer"
    error_message = "The writer login roles of app2 are not as expected."
  }
}

run "same_role_on_two_databases_is_rejected" {
  command = plan

  variables {
    databases = {
      app  = { reader_managed_identity_object_ids = [{ object_id = "11111111-1111-1111-1111-111111111111", principal_name = "shared-reader" }] }
      app2 = { reader_managed_identity_object_ids = [{ object_id = "11111111-1111-1111-1111-111111111111", principal_name = "shared-reader" }] }
    }
  }

  expect_failures = [azurerm_postgresql_flexible_server.this]
}

run "same_principal_with_role_prefix_is_still_rejected" {
  command = plan

  variables {
    databases = {
      app  = { reader_managed_identity_object_ids = [{ object_id = "11111111-1111-1111-1111-111111111111", principal_name = "shared-reader" }] }
      app2 = { reader_managed_identity_object_ids = [{ object_id = "11111111-1111-1111-1111-111111111111", principal_name = "shared-reader", role_prefix = "app2-shared-reader" }] }
    }
  }

  expect_failures = [azurerm_postgresql_flexible_server.this]
}

run "same_principal_with_two_access_levels_is_rejected" {
  command = plan

  variables {
    databases = {
      app  = { reader_managed_identity_object_ids = [{ object_id = "11111111-1111-1111-1111-111111111111", principal_name = "app-mi" }] }
      app2 = { writer_managed_identity_object_ids = [{ object_id = "11111111-1111-1111-1111-111111111111", principal_name = "app-mi" }] }
    }
  }

  expect_failures = [azurerm_postgresql_flexible_server.this]
}

run "same_group_name_on_two_databases_is_rejected" {
  command = plan

  variables {
    databases = {
      app  = { reader_groups = [{ group_name = "data-team" }] }
      app2 = { admin_groups = [{ group_name = "data-team" }] }
    }
  }

  expect_failures = [azurerm_postgresql_flexible_server.this]
}

run "a_principal_per_database_via_entra_groups" {
  command = plan

  variables {
    databases = {
      app  = { reader_groups = [{ group_name = "app-readers", object_id = "55555555-5555-5555-5555-555555555555" }] }
      app2 = { writer_groups = [{ group_name = "app2-writers", object_id = "66666666-6666-6666-6666-666666666666" }] }
    }
  }

  assert {
    condition     = module.database["app"].access.groups == { readers = "app_readers" } && module.database["app2"].access.groups == { writers = "app2_writers" }
    error_message = "Separate Entra groups per database must each get their own access group."
  }
}

run "password_owner_needs_password_authentication" {
  command = plan

  variables {
    databases = {
      app = { local_owner_account = { username = "app_owner" } }
    }
  }

  expect_failures = [azurerm_postgresql_flexible_server.this]
}

run "federated_owner_without_password_authentication" {
  command = plan

  variables {
    databases = {
      app = { local_owner_account = { username = "app_owner", object_id = "44444444-4444-4444-4444-444444444444" } }
    }
  }

  assert {
    condition     = length(random_password.password) == 0
    error_message = "A federated owner must not need password authentication."
  }
}

run "an_authentication_method_is_required" {
  command = plan

  variables {
    active_directory_auth_enabled = false
  }

  expect_failures = [azurerm_postgresql_flexible_server.this]
}

run "provisioning_identity_name_max_63_characters" {
  command = plan

  variables {
    provisioning_identity_name = "a-very-long-guest-user-principal-name#EXT#@example.onmicrosoft.com"
  }

  expect_failures = [var.provisioning_identity_name]
}
